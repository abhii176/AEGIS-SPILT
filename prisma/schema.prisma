generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  FREELANCER
}

/// Consent document kinds. MONITORING covers the full User Consent Agreement (incl. chats/calls).
enum ConsentType {
  MONITORING
  TERMS_OF_SERVICE
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  /// Both parties agreed to cancel in-app
  CANCELLED_MUTUAL
  /// Client cancelled without freelancer agreement (penalty path)
  CANCELLED_BY_CLIENT
  /// Freelancer abandoned; deposit forfeited
  ABANDONED_BY_FREELANCER
  DISPUTED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  IN_PROGRESS
  SUBMITTED
  AUDITING
  PASSED
  FAILED
  /// Escrow released / payout initiated (hackathon + AI auditor hook)
  RELEASED
  PAID
  CANCELLED
}

enum ProjectFundedStatus {
  UNFUNDED
  PARTIAL
  FUNDED
}

enum VaultFundStatus {
  PENDING
  ORDER_CREATED
  CAPTURED
  FAILED
  CANCELLED
}

/// Freelancer security deposit lifecycle.
enum DepositStatus {
  PENDING
  HELD
  RETURNED
  FORFEITED
}

enum CancellationRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  SUPERSEDED
}

/// Which exit path was executed (money rules differ).
enum ExitPath {
  MUTUAL
  CLIENT_ONESIDED
  FREELANCER_WALKAWAY
}

enum DepositDisposition {
  NONE
  RETURNED
  FORFEITED
}

model User {
  id                       String   @id @default(cuid())
  email                    String   @unique
  name                     String?
  role                     UserRole @default(CLIENT)
  /// ISO 3166-1 alpha-2 country code used to route KYC (e.g. IN → DigiLocker)
  countryCode              String?  @map("country_code")
  locale                   String?  @default("en")
  /// PayPal sandbox/live email used as Payouts recipient for freelancers
  paypalEmail              String?  @map("paypal_email")
  govIdVerified            Boolean  @default(false) @map("gov_id_verified")
  /// e.g. 'digilocker', 'stripe_identity', or a regional equivalent
  kycProvider              String?  @map("kyc_provider")
  monitoringConsentGranted Boolean  @default(false) @map("monitoring_consent_granted")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  consentLogs              ConsentLogs[]
  projectsAsClient         Project[]               @relation("ProjectClient")
  projectsAsFreelancer     Project[]               @relation("ProjectFreelancer")
  vaultFunds               VaultFund[]
  freelancerDeposits       FreelancerDeposit[]
  mergeEvents              MergeEvent[]
  notifications            Notification[]
  cancellationRequests     CancellationRequest[]   @relation("CancellationRequester")
  cancellationResponses    CancellationRequest[]   @relation("CancellationResponder")
  exitEvents               ExitEvent[]
  chatMessages             ChatMessage[]

  @@map("users")
}

/// Exact timestamp + IP when the user agreed to the User Consent Agreement.
model ConsentLogs {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  consentType    ConsentType @map("consent_type")
  /// Document / policy version the user accepted (e.g. 2.0.0)
  consentVersion String      @map("consent_version")
  /// Server-recorded moment of agreement
  agreedAt       DateTime    @default(now()) @map("agreed_at")
  /// Client IP at the time of agreement
  ipAddress      String      @map("ip_address")
  userAgent      String?     @map("user_agent")
  metadata       Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentType, consentVersion])
  @@map("consent_logs")
}

/// Client + freelancer engagement with milestones and escrowed payouts.
model Project {
  id           String        @id @default(cuid())
  clientId     String        @map("client_id")
  freelancerId String        @map("freelancer_id")
  title        String
  description  String?
  status       ProjectStatus @default(DRAFT)
  /// Aggregate escrow lock state for the project vault
  fundedStatus ProjectFundedStatus @default(UNFUNDED) @map("funded_status")
  /// Early-exit penalty as percent of remaining vault (client one-sided cancel)
  earlyExitPenaltyPercent Int @default(50) @map("early_exit_penalty_percent")
  /// Freelancer security deposit in cents (null → 10% of milestone total until locked)
  freelancerDepositAmountCents Int? @map("freelancer_deposit_amount_cents")
  /// High-level deposit lifecycle for the project
  depositStatus DepositStatus @default(PENDING) @map("deposit_status")
  /// Most recent PayPal Orders v2 order id that locked project/milestone funds
  paypalOrderId   String? @map("paypal_order_id")
  /// Most recent PayPal capture id after client payment is captured
  paypalCaptureId String? @map("paypal_capture_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  client               User                  @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Restrict)
  freelancer           User                  @relation("ProjectFreelancer", fields: [freelancerId], references: [id], onDelete: Restrict)
  milestones           Milestone[]
  vaultFunds           VaultFund[]
  freelancerDeposits   FreelancerDeposit[]
  mergeEvents          MergeEvent[]
  notifications        Notification[]
  cancellationRequests CancellationRequest[]
  exitEvents           ExitEvent[]
  chatMessages         ChatMessage[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@index([fundedStatus])
  @@index([depositStatus])
  @@map("projects")
}

/// Plain-text project chat between client and freelancer (no calls/voice/video).
model ChatMessage {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  senderUserId String   @map("sender_user_id")
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([senderUserId])
  @@map("chat_messages")
}

/// Milestone: task, acceptance rules, amount; optional GitHub fields for later merge/audit.
model Milestone {
  id                  String          @id @default(cuid())
  projectId           String          @map("project_id")
  /// Human-readable order within the project (1-based recommended)
  sequence            Int             @default(1)
  title               String
  /// Task description the freelancer must complete
  taskDescription     String          @map("task_description")
  /// Rules the AI auditor (and parties) use to accept the work
  acceptanceCriteria  String          @map("acceptance_criteria")
  /// Escrow amount for this milestone in the smallest currency unit (e.g. cents)
  amountCents         Int             @map("amount_cents")
  currency            String          @default("USD")
  status              MilestoneStatus @default(PENDING)
  /// Optional GitHub repo (owner/name) linked for this milestone
  githubRepoFullName  String?         @map("github_repo_full_name")
  /// Optional PR number once work is submitted
  githubPrNumber      Int?            @map("github_pr_number")
  /// Optional full PR URL for later webhook / AI audit wiring
  githubPrUrl         String?         @map("github_pr_url")
  /// Merge commit SHA once the linked PR is merged
  githubMergeSha      String?         @map("github_merge_sha")
  /// When the linked PR was merged (from webhook or demo simulate)
  githubMergedAt      DateTime?       @map("github_merged_at")
  /// AI auditor pass/fail (null until audit runs)
  auditPassed         Boolean?        @map("audit_passed")
  /// Human-readable audit summary for demo / next AI PR
  auditReport         String?         @map("audit_report") @db.Text
  auditCheckedAt      DateTime?       @map("audit_checked_at")
  /// PayPal Payouts batch id once this milestone is released
  paypalPayoutBatchId String?         @map("paypal_payout_batch_id")
  /// PayPal Payouts item id for this milestone release
  paypalPayoutItemId  String?         @map("paypal_payout_item_id")
  /// Email used as Payouts receiver (usually freelancer.paypalEmail)
  payoutEmail         String?         @map("payout_email")
  releasedAt          DateTime?       @map("released_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vaultFunds    VaultFund[]
  mergeEvents   MergeEvent[]
  notifications Notification[]

  @@index([projectId])
  @@index([status])
  @@index([githubRepoFullName, githubPrNumber])
  @@unique([projectId, sequence])
  @@map("milestones")
}

/// Vault funding via PayPal Orders — gated by KYC + monitoring consent.
model VaultFund {
  id              String          @id @default(cuid())
  userId          String          @map("user_id")
  projectId       String?         @map("project_id")
  /// When set, this fund locks a single milestone; otherwise full project/custom amount
  milestoneId     String?         @map("milestone_id")
  amountCents     Int             @map("amount_cents")
  currency        String          @default("USD")
  status          VaultFundStatus @default(PENDING)
  paypalOrderId   String?         @map("paypal_order_id")
  paypalCaptureId String?         @map("paypal_capture_id")
  /// PayPal approve link when capture is deferred to buyer redirect
  approvalUrl     String?         @map("approval_url")
  /// Cents already refunded from this capture (idempotent exit refunds)
  refundedCents   Int             @default(0) @map("refunded_cents")
  paypalRefundIds String[]        @default([]) @map("paypal_refund_ids")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([paypalOrderId])
  @@map("vault_funds")
}

/// Freelancer security deposit — PayPal Orders approve → capture (same rails as vault).
model FreelancerDeposit {
  id              String          @id @default(cuid())
  userId          String          @map("user_id")
  projectId       String          @map("project_id")
  amountCents     Int             @map("amount_cents")
  currency        String          @default("USD")
  status          VaultFundStatus @default(PENDING)
  paypalOrderId   String?         @map("paypal_order_id")
  paypalCaptureId String?         @map("paypal_capture_id")
  approvalUrl     String?         @map("approval_url")
  /// Payout/refund ids when deposit is returned or forfeited
  dispositionBatchId String?      @map("disposition_batch_id")
  dispositionItemId  String?      @map("disposition_item_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([paypalOrderId])
  @@map("freelancer_deposits")
}

/// In-app mutual-cancel request (one party asks, other accepts).
model CancellationRequest {
  id                 String                     @id @default(cuid())
  projectId          String                     @map("project_id")
  requestedByUserId  String                     @map("requested_by_user_id")
  reason             String?
  status             CancellationRequestStatus  @default(PENDING)
  respondedByUserId  String?                    @map("responded_by_user_id")
  respondedAt        DateTime?                  @map("responded_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("CancellationRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  respondedBy User?   @relation("CancellationResponder", fields: [respondedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([requestedByUserId])
  @@map("cancellation_requests")
}

/// Immutable record of an executed exit (money destinations + amounts).
model ExitEvent {
  id                     String              @id @default(cuid())
  projectId              String              @map("project_id")
  exitPath               ExitPath            @map("exit_path")
  initiatedByUserId      String              @map("initiated_by_user_id")
  reason                 String?
  /// Snapshot of remaining vault before distribution (cents)
  remainingVaultCents    Int                 @map("remaining_vault_cents")
  /// Penalty paid to freelancer (client one-sided only), else 0
  penaltyCents           Int                 @default(0) @map("penalty_cents")
  /// Refunded back to client from vault
  clientRefundCents      Int                 @default(0) @map("client_refund_cents")
  /// Extra payout to freelancer from vault (penalty)
  freelancerPayoutCents  Int                 @default(0) @map("freelancer_payout_cents")
  /// Deposit amount involved (if any)
  depositCents           Int                 @default(0) @map("deposit_cents")
  depositDisposition     DepositDisposition  @default(NONE) @map("deposit_disposition")
  /// Optional PayPal / mock transfer ids (column transfer_ids)
  transferIds            Json?               @map("transfer_ids")
  /// Idempotency: one successful exit per project
  idempotencyKey         String              @unique @map("idempotency_key")
  createdAt              DateTime            @default(now()) @map("created_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  initiatedBy User    @relation(fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([exitPath])
  @@map("exit_events")
}

/// Code merge events from GitHub webhooks or hackathon demo simulate.
model MergeEvent {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  projectId    String?  @map("project_id")
  milestoneId  String?  @map("milestone_id")
  prNumber     Int?     @map("pr_number")
  repoFullName String?  @map("repo_full_name")
  mergeSha     String?  @map("merge_sha")
  /// webhook | demo | manual
  source       String?  @default("manual")
  /// Optional diff stub / payload metadata for audit replay
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([milestoneId])
  @@map("merge_events")
}

/// In-app alerts for funded vault, AI audit result, payout, and exit events.
model Notification {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  /// FUNDED | AUDIT_PASSED | AUDIT_FAILED | PAID | CANCEL_* | DEPOSIT_*
  type        String
  message     String
  projectId   String?   @map("project_id")
  milestoneId String?   @map("milestone_id")
  /// Idempotency key per user (e.g. FUNDED:<milestoneId>)
  dedupeKey   String?   @map("dedupe_key")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([projectId])
  @@index([milestoneId])
  @@map("notifications")
}
