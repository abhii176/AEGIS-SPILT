# Server
PORT=3000
NODE_ENV=development
# Public origin (PayPal return/cancel). On Render/Railway/Fly you can omit this —
# the app falls back to RENDER_EXTERNAL_URL / RAILWAY_PUBLIC_DOMAIN / FLY_APP_NAME.
APP_BASE_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aegis_split?schema=public

# DigiLocker OAuth (India gov-ID KYC) — placeholders only
DIGILOCKER_CLIENT_ID=your_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret
DIGILOCKER_AUTH_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/auth/verify-identity/callback/digilocker

# Stripe Identity (international / regional gov-ID KYC) — placeholders only
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_IDENTITY_RETURN_URL=http://localhost:3000/api/auth/verify-identity/callback/stripe

# Consent document version (User Consent Agreement; bump when terms change)
MONITORING_CONSENT_VERSION=2.0.0

# Default milestone currency when clients omit currency on create (ISO 4217)
DEFAULT_MILESTONE_CURRENCY=USD

# PayPal REST (Orders + Payouts) — sandbox placeholders only; never commit real secrets
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
# sandbox | live
PAYPAL_MODE=sandbox
# true = return mock order/payout IDs without calling PayPal (local demo without credentials)
# Set false and fill real sandbox client id/secret for live sandbox Orders/Payouts.
PAYPAL_MOCK=true
# false (default) = create order → redirect buyer to approvalUrl → capture on return callback
# true = create+capture immediately (mock/local only; live sandbox fails with ORDER_NOT_APPROVED)
PAYPAL_AUTO_CAPTURE=false
# Buyer return/cancel after PayPal approve (defaults derived from APP_BASE_URL)
PAYPAL_RETURN_URL=http://localhost:3000/api/vault/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/api/vault/paypal/cancel
# Sandbox personal (buyer) account email for demo login — email only, never password
# Find under developer.paypal.com → Sandbox → Accounts (Personal)
# PAYPAL_BUYER_EMAIL=sb-buyer@personal.example.com
# Optional default freelancer payout email when User.paypalEmail is unset
# PAYPAL_PAYOUT_EMAIL=sb-freelancer@business.example.com
# PayPal webhook id from Developer Dashboard → App → Webhooks (REST verify-webhook-signature)
# Listener URL: {APP_BASE_URL}/api/webhooks/paypal — omit/placeholder refuses webhooks with 503
# Approve → return → capture flow does NOT require this; only inbound PayPal webhook POSTs do.
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Hackathon admin/demo trigger key (header X-Demo-Admin-Key on /api/admin/demo/*)
DEMO_ADMIN_KEY=hackathon-demo-key

# GitHub webhooks + PR diff fetch — placeholders only; never commit real secrets
# HMAC secret configured on the GitHub webhook (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
# Personal access token (or installation token) to GET /repos/{owner}/{repo}/pulls/{n} as diff
# Optional for local demo: pass a diff stub in webhook/demo body instead
GITHUB_TOKEN=ghp_your_github_pat_or_installation_token
GITHUB_API_BASE_URL=https://api.github.com
# Optional GitHub App (future): install on the linked repo; webhook still uses GITHUB_WEBHOOK_SECRET
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=

# AI auditor (milestone acceptanceCriteria vs PR diff)
# Prefer a real LLM when a key is set; otherwise deterministic diff/path heuristics (demo-safe, no key).
# AI_AUDITOR_PROVIDER: auto | openai | anthropic | deterministic
# Defaults are gpt-4o-mini and Claude 3.5 Haiku, not GPT-4o / Claude 3.5 Sonnet.
# Set OPENAI_MODEL / ANTHROPIC_MODEL if you want different model ids.
AI_AUDITOR_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Set true to fail closed if the LLM call errors (default: fall back to deterministic)
# AI_AUDITOR_STRICT=false
