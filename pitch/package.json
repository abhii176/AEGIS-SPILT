  "dependencies": {
    "@remotion/cli": "4.0.441",
    "@remotion/google-fonts": "4.0.441",
    "@remotion/media": "4.0.441",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.441"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "typescript": "5.8.2"
  }
}
